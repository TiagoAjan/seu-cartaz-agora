# Modo local SQLite. Para executar conectado ao Supabase, descomente as três variáveis da seção nuvem.
CARTAZ_DB=./data/cartazes.sqlite

# Modo Supabase. Na Netlify, defina as variáveis de nuvem no painel com escopo Functions.
# CARTAZ_STORAGE=supabase
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# CARTAZ_ORIGIN=https://SEU-SITE.netlify.app

# Para servir SQLite atrás de HTTPS.
# CARTAZ_SECURE_COOKIE=true

